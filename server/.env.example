# 腾讯云密钥配置模板
# 复制本文件为 server/.env 并填入真实值（server/.env 已被 .gitignore 忽略，切勿提交）
#
# 重要：请务必使用【子账号】密钥，并在 CAM 中授予 QcloudASRFullAccess 等最小必要权限。
# 主账号密钥一旦泄露风险极高。

TENCENT_SECRET_ID=在此填入你的 SecretId
TENCENT_SECRET_KEY=在此填入你的 SecretKey
TENCENT_APP_ID=在此填入你的 AppId

# 地域（一句话识别推荐 ap-guangzhou / ap-shanghai）
TENCENT_REGION=ap-guangzhou

# 本地签名服务端口
PORT=8787